<Window
    x:Class="Samy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SAMY">

    <Grid Background="{StaticResource SamyBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Compact top bar -->
        <Grid Grid.Row="0" Padding="22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="26" Height="26" CornerRadius="9" Background="{StaticResource SamyAccentBrush}">
                    <TextBlock Text="S" Foreground="#FF17121D" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SAMY" Foreground="{StaticResource SamyTextBrush}"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="PREVIEW" Foreground="{StaticResource SamyMutedBrush}"
                           FontSize="9" CharacterSpacing="150" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#FF050609" BorderBrush="#FF343846"
                    BorderThickness="1" CornerRadius="0,0,18,18" Padding="22,7"
                    MinWidth="180">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource SamyAccentBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="SAMY  /  READY" Foreground="#FFF4EFF8"
                               FontSize="10" FontWeight="SemiBold" CharacterSpacing="80"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="ClockText" Grid.Column="2" Text="--:--"
                       Foreground="{StaticResource SamyMutedBrush}" FontSize="13"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Padding="18,8,18,18" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Touch-friendly navigation -->
            <Border Grid.Column="0" Background="{StaticResource SamySurfaceBrush}"
                    CornerRadius="18" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="WORKSPACE" Foreground="{StaticResource SamyMutedBrush}"
                                   FontSize="10" CharacterSpacing="140" Margin="10,8,0,12"/>
                        <Button Content="⌂   Home" HorizontalContentAlignment="Left"
                                MinHeight="48" Background="#FF30263A" Foreground="{StaticResource SamyAccentBrush}"/>
                        <Button Content="◷   Focus" HorizontalContentAlignment="Left"
                                MinHeight="48" Background="Transparent" Foreground="{StaticResource SamyTextBrush}"/>
                        <Button Content="▤   Notes" HorizontalContentAlignment="Left"
                                MinHeight="48" Background="Transparent" Foreground="{StaticResource SamyTextBrush}"/>
                        <Button Content="▣   File shelf" HorizontalContentAlignment="Left"
                                MinHeight="48" Background="Transparent" Foreground="{StaticResource SamyTextBrush}"/>
                        <Button Content="♫   Media" HorizontalContentAlignment="Left"
                                MinHeight="48" Background="Transparent" Foreground="{StaticResource SamyTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Border Height="1" Background="#FF303543" Margin="4,0,4,8"/>
                        <TextBlock Text="MADE TO STAY OUT OF THE WAY"
                                   TextWrapping="Wrap" Foreground="{StaticResource SamyMutedBrush}"
                                   FontSize="10" Margin="8,0,8,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dashboard -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <Grid>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Your space, at a glance"
                                       Foreground="{StaticResource SamyTextBrush}"
                                       FontSize="27" FontWeight="SemiBold"/>
                            <TextBlock Text="A calmer control centre for your Windows day."
                                       Foreground="{StaticResource SamyMutedBrush}" FontSize="13"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#FF202632" CornerRadius="20" Padding="13,8">
                            <TextBlock Text="WINDOWS 11" Foreground="{StaticResource SamyAccentBrush}"
                                       FontSize="10" FontWeight="SemiBold" CharacterSpacing="80"/>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SamySurfaceBrush}" CornerRadius="16" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="PROCESSOR" Foreground="{StaticResource SamyMutedBrush}"
                                           FontSize="10" CharacterSpacing="100"/>
                                <TextBlock x:Name="CpuText" Text="—" Foreground="{StaticResource SamyTextBrush}"
                                           FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock Text="SAMY process usage" Foreground="{StaticResource SamyMutedBrush}"
                                           FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource SamySurfaceBrush}" CornerRadius="16" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="APP MEMORY" Foreground="{StaticResource SamyMutedBrush}"
                                           FontSize="10" CharacterSpacing="100"/>
                                <TextBlock x:Name="MemoryText" Text="—" Foreground="{StaticResource SamyTextBrush}"
                                           FontSize="25" FontWeight="SemiBold"/>
                                <TextBlock Text="Working set" Foreground="{StaticResource SamyMutedBrush}"
                                           FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource SamySurfaceBrush}" CornerRadius="16" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="TODAY" Foreground="{StaticResource SamyMutedBrush}"
                                           FontSize="10" CharacterSpacing="100"/>
                                <TextBlock x:Name="DateText" Text="—" Foreground="{StaticResource SamyTextBrush}"
                                           FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock Text="Local date" Foreground="{StaticResource SamyMutedBrush}"
                                           FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SamySurfaceBrush}" CornerRadius="18" Padding="20">
                            <StackPanel Spacing="13">
                                <Grid>
                                    <TextBlock Text="FOCUS SESSION" Foreground="{StaticResource SamyMutedBrush}"
                                               FontSize="10" CharacterSpacing="120"/>
                                    <Border HorizontalAlignment="Right" Background="#FF2B2635"
                                            CornerRadius="12" Padding="8,4">
                                        <TextBlock Text="25 MIN" Foreground="{StaticResource SamyAccentBrush}"
                                                   FontSize="9" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="FocusText" Text="25:00" FontSize="42"
                                           FontWeight="SemiBold" Foreground="{StaticResource SamyTextBrush}"/>
                                <TextBlock x:Name="FocusStatusText" Text="A little progress adds up."
                                           Foreground="{StaticResource SamyMutedBrush}" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Button x:Name="FocusButton" Content="Start focus" Click="FocusButton_Click"
                                            MinHeight="44" Padding="18,0"
                                            Background="{StaticResource SamyAccentBrush}" Foreground="#FF17121D"/>
                                    <Button Content="Reset" Click="ResetFocusButton_Click"
                                            MinHeight="44" Padding="18,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource SamySurfaceBrush}"
                                CornerRadius="18" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="QUICK NOTE" Foreground="{StaticResource SamyMutedBrush}"
                                           FontSize="10" CharacterSpacing="120"/>
                                <TextBlock Text="Keep a thought close." Foreground="{StaticResource SamyTextBrush}"
                                           FontSize="18" FontWeight="SemiBold"/>
                                <TextBox x:Name="NoteBox" MinHeight="100" AcceptsReturn="True"
                                         TextWrapping="Wrap" PlaceholderText="Write a quick note..."
                                         Background="#FF10141C" BorderBrush="#FF343A48"
                                         Foreground="{StaticResource SamyTextBrush}"/>
                                <Grid>
                                    <TextBlock x:Name="NoteStatusText" Text="Saved on this device"
                                               Foreground="{StaticResource SamyMutedBrush}"
                                               FontSize="10" VerticalAlignment="Center"/>
                                    <Button Content="Save note" Click="SaveNoteButton_Click"
                                            HorizontalAlignment="Right" MinHeight="40"
                                            Background="#FF30263A" Foreground="{StaticResource SamyAccentBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{StaticResource SamySurfaceBrush}" CornerRadius="18" Padding="20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="COMING INTO FOCUS" Foreground="{StaticResource SamyMutedBrush}"
                                       FontSize="10" CharacterSpacing="120"/>
                            <TextBlock Text="Your tools, one small space." Foreground="{StaticResource SamyTextBrush}"
                                       FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="The first shell is in place. Clipboard history, file shelf, media sessions, calendar and the compact always-on-top mode will arrive as separate, testable features."
                                       Foreground="{StaticResource SamyMutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" MaxWidth="760"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="SAMY PREVIEW  •  LOCAL-FIRST  •  WINDOWS 11"
                               Foreground="#FF656B79" FontSize="9" CharacterSpacing="100"
                               HorizontalAlignment="Center" Margin="0,4,0,8"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
