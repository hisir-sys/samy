<Window
    x:Class="Samy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SAMY">
    <Grid x:Name="Root" Background="#FF0B0D12" Padding="14">
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="DragRegion" Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="11" Background="#FF111522" BorderBrush="#FFD7A5F4" BorderThickness="1">
                    <Viewbox Width="23" Height="23" Stretch="Uniform">
                        <Canvas Width="30" Height="30">
                            <Path Data="M 23,6 C 19,1 8,2 7,10 C 6,17 23,13 23,21 C 23,29 11,30 6,23" Stroke="#FFE8CDF9" StrokeThickness="3.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                            <Ellipse Canvas.Left="21" Canvas.Top="2" Width="4" Height="4" Fill="#FFD7A5F4"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock Text="SAMY" Foreground="#FFF6F3FA" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="ClockText" Text="--:--" Foreground="#FF9A9EAD" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button x:Name="PinButton" Content="PIN" Click="PinButton_Click" AutomationProperties.Name="Toggle always on top"/>
                <Button Content="−" Click="CollapseButton_Click" AutomationProperties.Name="Collapse SAMY"/>
                <Button Content="×" Click="CloseButton_Click" AutomationProperties.Name="Close SAMY"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="ExpandedContent" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="6" Margin="0,8,12,0">
                <Button Content="Home" Click="HomeNav_Click" MinHeight="44"/>
                <Button Content="Clipboard" Click="ClipboardNav_Click" MinHeight="44"/>
                <Button Content="File shelf" Click="FilesNav_Click" MinHeight="44"/>
                <Button Content="Media" Click="MediaNav_Click" MinHeight="44"/>
                <Button Content="Calendar" Click="CalendarNav_Click" MinHeight="44"/>
                <Button Content="Tools" Click="ToolsNav_Click" MinHeight="44"/>
                <Button Content="Insights" Click="InsightsNav_Click" MinHeight="44"/>
                <Button Content="Settings" Click="SettingsNav_Click" MinHeight="44"/>
                <TextBlock Text="LOCAL-FIRST · WINDOWS 11" Foreground="#FF777D8D" FontSize="9" TextWrapping="Wrap" Margin="4,14,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="HomePage" Spacing="14">
                        <TextBlock Text="Your space, at a glance" Foreground="#FFF6F3FA" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="A small workspace that stays close when you need it." Foreground="#FF9A9EAD"/>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel><TextBlock Text="FOCUS" Foreground="#FF9A9EAD" FontSize="10"/><TextBlock x:Name="FocusText" Text="25:00" FontSize="38" Foreground="#FFF6F3FA"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="FocusButton" Content="Start" Click="FocusButton_Click"/><Button Content="Reset" Click="ResetFocusButton_Click"/></StackPanel></StackPanel></Border>
                            <Border Grid.Column="1" Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel><TextBlock Text="SYSTEM" Foreground="#FF9A9EAD" FontSize="10"/><TextBlock x:Name="CpuText" Text="—" FontSize="24" Foreground="#FFF6F3FA"/><TextBlock x:Name="MemoryText" Text="—" Foreground="#FF9A9EAD"/><TextBlock x:Name="DateText" Text="—" Foreground="#FF9A9EAD"/></StackPanel></Border>
                        </Grid>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8"><TextBlock Text="QUICK NOTE" Foreground="#FFD7A5F4" FontSize="10"/><TextBox x:Name="NoteBox" PlaceholderText="Write a note saved only on this PC..." AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap"/><Button Content="Save note" Click="SaveNoteButton_Click" HorizontalAlignment="Right"/><TextBlock x:Name="NoteStatusText" Text="Stored locally" Foreground="#FF9A9EAD" FontSize="11"/></StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="6"><TextBlock Text="QUICK ACTIONS" Foreground="#FFD7A5F4" FontSize="10"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Add file" Click="AddFileButton_Click"/><Button Content="Open calendar" Click="OpenCalendarButton_Click"/><Button Content="Clipboard" Click="ClipboardNav_Click"/></StackPanel><TextBlock Text="Clipboard monitoring starts only when you enable it in Settings." Foreground="#FF9A9EAD" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border>
                    </StackPanel>
                    <StackPanel x:Name="ClipboardPage" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Clipboard history" FontSize="25" Foreground="#FFF6F3FA" FontWeight="SemiBold"/>
                        <TextBlock Text="Text-only history stored on this device. Passwords and other sensitive text should not be copied while capture is enabled." Foreground="#FF9A9EAD" TextWrapping="Wrap"/>
                        <TextBox x:Name="ClipboardSearchBox" PlaceholderText="Search clipboard history..." TextChanged="ClipboardSearchBox_TextChanged"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Copy latest" Click="CopyLatestButton_Click"/>
                            <Button Content="Pin / unpin" Click="PinClipboardButton_Click"/>
                            <Button Content="Delete selected" Click="DeleteClipboardButton_Click"/>
                            <Button Content="Clear all" Click="ClearClipboardButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ClipboardStatusText" Text="Capture is off." Foreground="#FFD7A5F4"/>
                        <ListView x:Name="ClipboardList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="ClipboardItem_Click" MaxHeight="480"/>
                    </StackPanel>
                    <StackPanel x:Name="FilesPage" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="File shelf" FontSize="25" Foreground="#FFF6F3FA" FontWeight="SemiBold"/>
                        <TextBlock Text="Pin files you choose. SAMY stores paths, not copies of your files. Use shelves to organise projects." Foreground="#FF9A9EAD" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="ShelfPicker" Width="180" PlaceholderText="Choose shelf" SelectionChanged="ShelfPicker_SelectionChanged"/><TextBox x:Name="NewShelfNameBox" Width="150" PlaceholderText="New shelf name"/><Button Content="Add shelf" Click="AddShelfButton_Click"/></StackPanel>
                        <Border x:Name="FileDropZone" AllowDrop="True" DragOver="FileDropZone_DragOver" Drop="FileDropZone_Drop" Background="#FF1B2030" BorderBrush="#FF8D71B8" BorderThickness="1" CornerRadius="10" Padding="14"><TextBlock Text="Drop files here to add them to the selected shelf · or choose files below" Foreground="#FFD7A5F4" TextWrapping="Wrap" HorizontalAlignment="Center"/></Border>
                        <Button Content="Choose files" Click="AddFileButton_Click" HorizontalAlignment="Left"/>
                        <ListView x:Name="FilesList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="FileItem_Click" CanDragItems="True" DragItemsStarting="FilesList_DragItemsStarting" MaxHeight="480"/>
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Open selected" Click="OpenSelectedFileButton_Click"/><Button Content="Copy path" Click="CopySelectedFilePathButton_Click"/><Button Content="Remove selected" Click="RemoveFileButton_Click"/><Button Content="Remove shelf" Click="RemoveShelfButton_Click"/></StackPanel>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8"><TextBlock Text="IMAGE &amp; PDF CONVERTER" Foreground="#FFD7A5F4" FontSize="10"/><ComboBox x:Name="ImageFormatBox" SelectedIndex="0"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPG"/><ComboBoxItem Content="WEBP"/><ComboBoxItem Content="BMP"/><ComboBoxItem Content="PDF"/><ComboBoxItem Content="PDF pages to PNG"/></ComboBox><Button Content="Choose image and convert" Click="ConvertImageButton_Click" HorizontalAlignment="Left"/><TextBlock x:Name="ConversionStatusText" Foreground="#FF9A9EAD" TextWrapping="Wrap"/></StackPanel></Border>
                    </StackPanel>
                    <StackPanel x:Name="MediaPage" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Media controls" FontSize="25" Foreground="#FFF6F3FA" FontWeight="SemiBold"/>
                        <Border Background="#FF151923" CornerRadius="14" Padding="16"><StackPanel Spacing="10"><TextBlock x:Name="MediaTitleText" Text="No active media session" FontSize="18" Foreground="#FFF6F3FA" TextWrapping="Wrap"/><TextBlock x:Name="MediaArtistText" Text="Start playing media in a supported Windows app." Foreground="#FF9A9EAD"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Previous" Click="PreviousMediaButton_Click"/><Button Content="Play / Pause" Click="PlayPauseMediaButton_Click"/><Button Content="Next" Click="NextMediaButton_Click"/></StackPanel><Button Content="Refresh session" Click="RefreshMediaButton_Click" HorizontalAlignment="Left"/></StackPanel></Border>
                    </StackPanel>
                    <StackPanel x:Name="CalendarPage" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Calendar" FontSize="25" Foreground="#FFF6F3FA" FontWeight="SemiBold"/>
                        <Border Background="#FF151923" CornerRadius="14" Padding="16"><StackPanel Spacing="10"><TextBlock x:Name="CalendarDateText" FontSize="20" Foreground="#FFF6F3FA"/><CalendarView x:Name="CalendarControl" IsGroupLabelVisible="False" IsOutOfScopeEnabled="False"/><Button Content="Open Windows calendar" Click="OpenCalendarButton_Click" HorizontalAlignment="Left"/>
                            <TextBlock Text="LOCAL REMINDERS" Foreground="#FFD7A5F4" FontSize="10"/>
                            <TextBox x:Name="ReminderTextBox" PlaceholderText="What should SAMY remind you about?"/>
                            <TimePicker x:Name="ReminderTimePicker" ClockIdentifier="24HourClock"/>
                            <ComboBox x:Name="ReminderRecurrenceBox" SelectedIndex="0"><ComboBoxItem Content="Does not repeat" Tag="ONCE"/><ComboBoxItem Content="Every day" Tag="DAILY"/><ComboBoxItem Content="Every week" Tag="WEEKLY"/><ComboBoxItem Content="Every month" Tag="MONTHLY"/></ComboBox>
                            <Button Content="Add reminder for selected day" Click="AddReminderButton_Click" HorizontalAlignment="Left"/>
                            <TextBlock Text="CALENDAR FEED SUBSCRIPTION" Foreground="#FFD7A5F4" FontSize="10"/><TextBox x:Name="CalendarFeedUrlBox" PlaceholderText="HTTPS .ics calendar feed URL"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Subscribe / refresh feed" Click="SubscribeCalendarFeedButton_Click"/><Button Content="Unsubscribe" Click="UnsubscribeCalendarFeedButton_Click"/></StackPanel>
                            <TextBlock x:Name="ReminderStatusText" Text="Reminders stay on this PC and appear inside SAMY." Foreground="#FF9A9EAD" TextWrapping="Wrap" FontSize="11"/>
                            <ListView x:Name="RemindersList" MaxHeight="180"/>
                            <TextBlock Text="SAMY provides a local date picker and in-app reminders, and can open your configured Windows calendar. It does not sync account calendars." Foreground="#FF9A9EAD" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border>
                    </StackPanel>
                    <StackPanel x:Name="ToolsPage" Visibility="Collapsed" Spacing="14">
                        <TextBlock Text="Everyday tools" FontSize="25" Foreground="#FFF6F3FA" FontWeight="SemiBold"/>
                        <TextBlock Text="Local utilities. Your notes, links and settings stay on this PC." Foreground="#FF9A9EAD" TextWrapping="Wrap"/>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8">
                            <TextBlock Text="POMODORO CYCLE" Foreground="#FFD7A5F4" FontSize="10"/>
                            <TextBlock x:Name="PomodoroPhaseText" Text="Focus" Foreground="#FF9A9EAD"/>
                            <TextBlock x:Name="PomodoroTimeText" Text="25:00" FontSize="36" Foreground="#FFF6F3FA"/>
                            <TextBlock x:Name="PomodoroSessionsText" Foreground="#FF9A9EAD" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="PomodoroStartButton" Content="Start" Click="PomodoroStart_Click"/><Button Content="Skip" Click="PomodoroSkip_Click"/><Button Content="Reset" Click="PomodoroReset_Click"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox x:Name="PomodoroFocusBox" Header="Focus (min)" Minimum="1" Maximum="180" Value="25" SpinButtonPlacementMode="Compact" Width="115"/>
                                <NumberBox x:Name="PomodoroShortBox" Header="Short break" Minimum="1" Maximum="60" Value="5" SpinButtonPlacementMode="Compact" Width="115"/>
                                <NumberBox x:Name="PomodoroLongBox" Header="Long break" Minimum="1" Maximum="120" Value="15" SpinButtonPlacementMode="Compact" Width="115"/>
                                <NumberBox x:Name="PomodoroCyclesBox" Header="Sessions per cycle" Minimum="2" Maximum="12" Value="4" SpinButtonPlacementMode="Compact" Width="140"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="PomodoroAutoToggle" Header="Start the next phase automatically" IsOn="True"/>
                            <Button Content="Apply Pomodoro settings" Click="PomodoroApply_Click" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="PomodoroStatusText" Foreground="#FF9A9EAD" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8">
                            <TextBlock Text="COUNTDOWN · STOPWATCH" Foreground="#FFD7A5F4" FontSize="10"/>
                            <TextBlock x:Name="ToolTimerText" Text="25:00" FontSize="36" Foreground="#FFF6F3FA"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Start / pause" Click="ToolTimerToggle_Click"/><Button Content="Reset" Click="ToolTimerReset_Click"/><Button Content="25 min" Click="ToolPomodoro_Click"/><Button Content="Stopwatch" Click="ToolStopwatch_Click"/></StackPanel>
                            <TextBox x:Name="CountdownMinutesBox" PlaceholderText="Countdown minutes (e.g. 5)"/>
                            <Button Content="Set countdown" Click="ToolCountdown_Click" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8">
                            <TextBlock Text="UNIT CONVERTER" Foreground="#FFD7A5F4" FontSize="10"/>
                            <ComboBox x:Name="UnitCategoryBox" Header="Category" MinWidth="200" SelectionChanged="UnitCategoryBox_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="UnitFromBox" Header="From" MinWidth="140"/>
                                <Button Content="⇄" Click="SwapUnitsButton_Click" VerticalAlignment="Bottom" AutomationProperties.Name="Swap units"/>
                                <ComboBox x:Name="UnitToBox" Header="To" MinWidth="140"/>
                            </StackPanel>
                            <TextBox x:Name="UnitInputBox" PlaceholderText="Enter a value"/>
                            <Button Content="Convert" Click="ConvertUnitButton_Click" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="UnitResultText" Foreground="#FFF6F3FA" FontSize="18"/>
                        </StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8">
                            <TextBlock Text="SAVED LINKS" Foreground="#FFD7A5F4" FontSize="10"/>
                            <TextBox x:Name="LinkTitleBox" PlaceholderText="Link title"/><TextBox x:Name="LinkUrlBox" PlaceholderText="https://example.com"/>
                            <Button Content="Save link" Click="SaveLinkButton_Click" HorizontalAlignment="Left"/>
                            <ListView x:Name="SavedLinksList" IsItemClickEnabled="True" ItemClick="SavedLinkItem_Click" MaxHeight="150"/>
                            <Button Content="Remove selected link" Click="RemoveLinkButton_Click" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8"><TextBlock Text="WORLD CLOCKS" Foreground="#FFD7A5F4" FontSize="10"/><TextBlock x:Name="WorldClocksText" Foreground="#FFF6F3FA" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Name="WorldClockAddBox" PlaceholderText="Add a zone, e.g. Asia/Tokyo" Width="230"/><Button Content="Add" Click="AddWorldClock_Click"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8"><ComboBox x:Name="WorldClockRemoveBox" PlaceholderText="Choose a clock to remove" Width="230"/><Button Content="Remove" Click="RemoveWorldClock_Click"/></StackPanel>
                            <TextBlock x:Name="WorldClockStatusText" Foreground="#FF9A9EAD" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8">
                            <TextBlock Text="CUSTOM MESSAGE" Foreground="#FFD7A5F4" FontSize="10"/><TextBox x:Name="MessageBox" PlaceholderText="Write a status message"/><Button Content="Show message" Click="ShowMessageButton_Click" HorizontalAlignment="Left"/><TextBlock x:Name="MessagePreviewText" Foreground="#FFD7A5F4" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8">
                            <TextBlock Text="LOCAL TASK CHECKLIST" Foreground="#FFD7A5F4" FontSize="10"/><TextBox x:Name="TaskBox" PlaceholderText="Add a task"/><Button Content="Add task" Click="AddTaskButton_Click" HorizontalAlignment="Left"/><ListView x:Name="TasksList" MaxHeight="150"/><Button Content="Complete selected task" Click="CompleteTaskButton_Click" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8">
                            <TextBlock Text="WEATHER · ONLINE" Foreground="#FFD7A5F4" FontSize="10"/>
                            <TextBox x:Name="WeatherCityBox" PlaceholderText="City name (e.g. Kolkata)"/>
                            <Button Content="Get current weather" Click="GetWeatherButton_Click" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="WeatherResultText" Foreground="#FFF6F3FA" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8">
                            <TextBlock Text="CURRENCY CONVERTER · ONLINE RATE" Foreground="#FFD7A5F4" FontSize="10"/>
                            <TextBox x:Name="CurrencyAmountBox" PlaceholderText="Amount" Text="1"/>
                            <StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Name="CurrencyFromBox" PlaceholderText="From (USD)" Width="110" Text="USD"/><TextBox x:Name="CurrencyToBox" PlaceholderText="To (INR)" Width="110" Text="INR"/></StackPanel>
                            <Button Content="Convert using latest available rate" Click="ConvertCurrencyButton_Click" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="CurrencyResultText" Foreground="#FFF6F3FA" TextWrapping="Wrap"/>
                        </StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8">
                            <TextBlock Text="SCREEN TIME · LOCAL DAILY REPORTS" Foreground="#FFD7A5F4" FontSize="10"/>
                            <TextBlock Text="Optional process-name and foreground-duration tracking. Reports are stored locally; SAMY does not record keystrokes, screenshots or window contents." Foreground="#FF9A9EAD" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ScreenTimeText" Foreground="#FFF6F3FA" Text="Enable screen-time tracking in Settings to begin."/>
                        </StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8"><TextBlock Text="CONNECTED SERVICES" Foreground="#FFD7A5F4" FontSize="10"/><TextBlock Text="Weather, screen-time reporting, coding analytics, sales analytics and revenue integrations require provider/location consent and dedicated validation. They are not shown as connected in this build." Foreground="#FF9A9EAD" TextWrapping="Wrap"/></StackPanel></Border>
                    </StackPanel>
                    <StackPanel x:Name="InsightsPage" Visibility="Collapsed" Spacing="14">
                        <TextBlock Text="System &amp; developer insights" FontSize="25" Foreground="#FFF6F3FA" FontWeight="SemiBold"/>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8"><TextBlock Text="WHOLE-DEVICE STATUS" Foreground="#FFD7A5F4" FontSize="10"/><TextBlock x:Name="SystemExtrasText" Text="Collecting disk, network, battery and audio status…" Foreground="#FFF6F3FA" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh system details" Click="RefreshSystemDetailsButton_Click"/><Button Content="Test Windows notification" Click="TestNotificationButton_Click"/></StackPanel></StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8"><TextBlock Text="CODING ACTIVITY · LOCAL GIT REPOSITORY" Foreground="#FFD7A5F4" FontSize="10"/><TextBlock Text="SAMY reads Git commit metadata and changed file extensions from a folder you select. No source code is uploaded." Foreground="#FF9A9EAD" TextWrapping="Wrap"/><TextBox x:Name="CodingRepoPathBox" PlaceholderText="Select a local Git repository folder"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Choose folder" Click="ChooseCodingRepoButton_Click"/><Button Content="Analyze last 30 days" Click="AnalyzeCodingButton_Click"/></StackPanel><TextBlock x:Name="CodingReportText" Foreground="#FFF6F3FA" TextWrapping="Wrap"/></StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="14"><StackPanel Spacing="8"><TextBlock Text="AUTHENTICATED ANALYTICS API" Foreground="#FFD7A5F4" FontSize="10"/><TextBlock Text="Connect a provider's HTTPS JSON endpoint with a bearer API token. SAMY tests the real endpoint and stores the token encrypted for this Windows account. No sample metrics are generated." Foreground="#FF9A9EAD" TextWrapping="Wrap"/><TextBox x:Name="ProviderEndpointBox" PlaceholderText="https://provider.example/api/analytics"/><PasswordBox x:Name="ProviderTokenBox" PlaceholderText="Bearer API token"/><Button Content="Test and save connection" Click="ConnectProviderButton_Click" HorizontalAlignment="Left"/><TextBlock x:Name="ProviderStatusText" Foreground="#FFF6F3FA" TextWrapping="Wrap"/></StackPanel></Border>
                    </StackPanel>
                    <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Spacing="14">
                        <TextBlock Text="Settings" FontSize="25" Foreground="#FFF6F3FA" FontWeight="SemiBold"/>
                        <Border Background="#FF151923" CornerRadius="14" Padding="16"><StackPanel Spacing="12">
                            <TextBlock Text="WINDOW BEHAVIOR" Foreground="#FFD7A5F4" FontSize="10"/>
                            <ToggleSwitch x:Name="AlwaysOnTopToggle" Header="Keep SAMY always on top" Toggled="AlwaysOnTopToggle_Toggled"/>
                            <ToggleSwitch x:Name="StartWithWindowsToggle" Header="Launch SAMY when I sign in" Toggled="StartWithWindowsToggle_Toggled"/>
                            <ToggleSwitch x:Name="ClipboardToggle" Header="Enable local clipboard history (text only)" Toggled="ClipboardToggle_Toggled"/>
                            <ToggleSwitch x:Name="ScreenTimeToggle" Header="Enable local screen-time reports" Toggled="ScreenTimeToggle_Toggled"/>
                            <TextBlock Text="Clipboard capture is off by default. Turning it on stores copied text locally until you clear it or turn capture off." Foreground="#FF9A9EAD" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Text="RETENTION &amp; EXCLUSIONS" Foreground="#FFD7A5F4" FontSize="10"/>
                            <ComboBox x:Name="ClipboardRetentionBox" SelectedIndex="1" SelectionChanged="ClipboardRetentionBox_SelectionChanged">
                                <ComboBoxItem Content="Keep for 1 day"/>
                                <ComboBoxItem Content="Keep for 7 days"/>
                                <ComboBoxItem Content="Keep for 30 days"/>
                                <ComboBoxItem Content="Never expire"/>
                            </ComboBox>
                            <TextBox x:Name="ClipboardExclusionsBox" PlaceholderText="Sensitive words to exclude, comma-separated"/>
                            <Button Content="Save clipboard privacy settings" Click="SaveClipboardPrivacyButton_Click" HorizontalAlignment="Left"/>
                        </StackPanel></Border>
                        <Border Background="#FF151923" CornerRadius="14" Padding="16"><StackPanel Spacing="10"><TextBlock Text="PRIVACY &amp; ACCESSIBILITY" Foreground="#FFD7A5F4" FontSize="10"/><Button Content="Clear clipboard history" Click="ClearClipboardButton_Click" HorizontalAlignment="Left"/><Button Content="Open local data folder" Click="OpenDataFolderButton_Click" HorizontalAlignment="Left"/><TextBlock Text="Controls have accessible names, visible labels, keyboard focus, and touch-friendly sizing. Notes, settings, and file paths remain on this PC." Foreground="#FF9A9EAD" TextWrapping="Wrap"/></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>